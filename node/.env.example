MTA_HOST=127.0.0.1
MTA_PORT=22005
# Must match an existing MTA account (create with: addaccount <user> <pass>)
# Quote values that contain # or spaces, e.g. MTA_PASS="secret#1"
MTA_USER=your_http_user
MTA_PASS=your_http_password
MIDDLEWARE_PORT=3847
MIDDLEWARE_HOST=127.0.0.1
MIDDLEWARE_URL=http://127.0.0.1:3847
# Background status poll for /dashboard and mta://server/status (milliseconds)
STATUS_POLL_INTERVAL_MS=8000
# Performance categories pre-fetched each poll (comma-separated)
STATUS_PERF_CATEGORIES=Lua timing,Lua memory
MEMORY_DB=./data/memory.db
MTA_RESOURCE=agent
AGENT_PLAYER=
AGENT_PLAYER_SERIAL=
# Gates middleware POST /mta/eval and eval.server (not MTA :22005 /agent/call/eval)
ALLOW_HTTP_EVAL=0
ALLOW_RESTART=0

# Auto-created as node/.env on first Node/MTA start if missing (copy of this file).
